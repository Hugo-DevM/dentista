---
import { Icon } from 'astro-icon/components';
import { hero, hechos, contacto, CTA_PRINCIPAL } from '../data/clinica';

const mensajeWa = encodeURIComponent(
  'Hola, vengo del sitio de Alvea y quiero agendar una valoración.'
);
---

<section class="hero" id="inicio">
  <div class="hero__rejilla">
    <div class="hero__copia reveal" data-reveal-order="0">
      <h1>
        {hero.titulo}{' '}
        <span class="hero__acento">{hero.tituloAcento}</span>
      </h1>
      <p class="hero__entrada">{hero.entrada}</p>
      <div class="hero__acciones">
        <a class="btn btn--lg" href="#cita" data-evento="cta_cita">
          {CTA_PRINCIPAL}
          <Icon name="ph:arrow-right" aria-hidden="true" />
        </a>
        <a
          class="btn btn--lg btn--ghost"
          href={`https://wa.me/${contacto.whatsapp}?text=${mensajeWa}`}
          target="_blank"
          rel="noopener"
        >
          <Icon name="ph:whatsapp-logo" aria-hidden="true" />
          WhatsApp
        </a>
      </div>
    </div>

    <div class="hero__tiles reveal" data-reveal-order="2">
      <img
        src="/img/hero-clinica.jpg"
        width="620"
        height="620"
        alt="Consultorio dental de Alvea con sillón y equipo en color verde azulado"
        loading="eager"
        decoding="async"
      />
      <img
        src="/img/hero-consulta.jpg"
        width="620"
        height="620"
        alt="Odontóloga sonriendo mientras revisa el expediente de una paciente"
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="hero__principal reveal" data-reveal-order="1">
      <img
        src="/img/hero-principal.jpg"
        width="900"
        height="1160"
        alt="Odontólogo explicando una radiografía a una paciente sentada en el sillón dental"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>

<section class="hechos" aria-label="Lo que incluye tu primera visita">
  <ul>
    {
      hechos.map((h, i) => (
        <li class="reveal" data-reveal-order={i}>
          <Icon name={h.icono} aria-hidden="true" />
          <div>
            <p class="hechos__titulo">{h.titulo}</p>
            <p class="hechos__detalle">{h.detalle}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .hero {
    --hero-pad-t: clamp(18px, 2.2vw, 38px);
    --hero-pad-b: clamp(16px, 1.8vw, 28px);
    padding: var(--hero-pad-t) var(--pad-x) var(--hero-pad-b);
  }

  /* Bento: la copia y los dos tiles ocupan la columna izquierda en dos
     filas; la imagen principal ocupa la columna derecha completa. */
  .hero__rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    grid-template-rows: auto auto;
    gap: var(--gap);
  }

  .hero__copia {
    grid-column: 1;
    grid-row: 1;
    align-self: center;
    min-height: 0;
    padding-block: clamp(2px, 0.8vw, 12px);
    padding-right: clamp(0px, 2vw, 34px);
  }

  /* El tamaño se eligió contra el ancho real de la columna: "Tratamientos
     dentales" debe caber en una línea para que el titular sean dos, no tres. */
  .hero__copia h1 {
    font-size: clamp(2.05rem, 3.2vw, 2.7rem);
    line-height: 1.06;
    letter-spacing: -0.04em;
    max-width: 21ch;
  }

  .hero__acento { color: var(--accent); }

  .hero__entrada {
    margin-top: 18px;
    max-width: 44ch;
    color: var(--ink-2);
    font-size: clamp(0.975rem, 1.05vw, 1.06rem);
    line-height: 1.62;
  }

  .hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .hero__tiles {
    grid-column: 1;
    grid-row: 2;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
  }

  .hero__tiles img {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--r-card);
    background: var(--surface-2);
  }

  .hero__principal {
    grid-column: 2;
    grid-row: 1 / span 2;
  }

  .hero__principal img {
    width: 100%;
    height: 100%;
    min-height: clamp(380px, 52vw, 620px);
    object-fit: cover;
    border-radius: var(--r-card);
    background: var(--surface-2);
  }

  /* --------------------------- Franja de hechos ------------------------ */

  .hechos {
    padding: clamp(14px, 1.6vw, 22px) var(--pad-x) clamp(24px, 2.6vw, 40px);
  }

  .hechos ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    overflow: clip;
  }

  .hechos li {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 20px 22px;
    background: var(--surface);
  }

  .hechos li :global(svg) {
    width: 22px;
    height: 22px;
    color: var(--accent);
    flex: none;
    margin-top: 1px;
  }

  .hechos__titulo {
    font-size: 0.925rem;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .hechos__detalle {
    margin-top: 3px;
    font-size: 0.813rem;
    color: var(--ink-2);
    line-height: 1.45;
  }

  /* ---------------------- Ajuste a la altura de la ventana -------------
     En escritorio el bento completo (titular, botones y las tres fotos)
     debe caber bajo la cabecera sin scroll. La rejilla toma como alto lo
     que queda de ventana y la segunda fila se lleva el sobrante, así que
     los tiles recortan por object-fit en vez de empujar la página.
     El tope evita que en monitores muy altos el hero crezca sin control;
     el mínimo evita que en pantallas muy bajas los tiles desaparezcan. */
  @media (min-width: 1021px) {
    .hero__rejilla {
      height: calc(
        100svh - var(--shell-pad) - var(--alto-cabecera) - var(--hero-pad-t) - var(--hero-pad-b)
      );
      min-height: 400px;
      max-height: 700px;
      grid-template-rows: auto minmax(0, 1fr);
    }

    .hero__tiles { min-height: 0; }

    .hero__tiles img {
      aspect-ratio: auto;
      height: 100%;
      min-height: 0;
    }

    .hero__principal img {
      min-height: 0;
      height: 100%;
    }
  }

  /* Ventanas muy bajas (portátiles de 13" con mucho cromo de navegador):
     se recorta el bloque de texto para que a los tiles les quede altura
     suficiente y no queden reducidos a una franja. */
  @media (min-width: 1021px) and (max-height: 600px) {
    .hero__copia h1 { font-size: clamp(1.75rem, 2.5vw, 2.15rem); }
    .hero__entrada { margin-top: 12px; font-size: 0.95rem; }
    .hero__acciones { margin-top: 18px; }
    .hero__copia .btn { padding-block: 12px; }
  }

  /* ------------------------------- Cortes ------------------------------ */

  @media (max-width: 1020px) {
    .hero__rejilla {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto auto;
    }
    .hero__copia { grid-column: 1; grid-row: 1; padding-right: 0; }
    .hero__principal { grid-column: 1; grid-row: 2; }
    .hero__principal img { min-height: 0; aspect-ratio: 16 / 11; height: auto; }
    .hero__tiles { grid-column: 1; grid-row: 3; }
    .hero__copia h1 { max-width: 18ch; }

    .hechos ul { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 560px) {
    .hero__copia h1 { font-size: clamp(2rem, 8.4vw, 2.5rem); max-width: 100%; }
    .hero__acciones { display: grid; grid-template-columns: 1fr; }
    .hero__principal img { aspect-ratio: 4 / 3; }
    .hechos ul { grid-template-columns: minmax(0, 1fr); }
  }
</style>
